DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rumisocial"
OPENAI_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RUNWAY_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OPENAI_TEXT_MODEL="gpt-5.6-luna"
# Visual review of campaign images; at most two reviews and one replacement per request.
OPENAI_PHOTO_REVIEW_MODEL="gpt-4.1-mini"
WORKER_SECRET="change-me"
RUNWAY_VIDEO_MODEL="gen4.5"
TOKEN_ENCRYPTION_KEY="replace-with-long-random-secret"
ADMIN_SECRET="replace-with-admin-secret"
AUTH_SECRET="replace-with-auth-secret"
AUTH_TRUST_HOST="true"
STRIPE_TOPUP_SMALL_PRICE_ID=""
STRIPE_TOPUP_MEDIUM_PRICE_ID=""
STRIPE_TOPUP_LARGE_PRICE_ID=""
DATABASE_DIRECT_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Private Vercel Blob store used for generated video files
BLOB_READ_WRITE_TOKEN=""

# Optional production-only override, preserving preview credentials
RUNWAY_PRODUCTION_API_KEY=""

# Default campaign image provider. Set openai explicitly to use the premium alternative.
IMAGE_PROVIDER="bfl"
# Server-only credentials for default images and presenter ads, also used by AI Test Lab.
BFL_API_KEY=""
WAVESPEED_API_KEY=""
# Maximum daily reserved provider estimates per workspace; hard maximum $10.
AI_LAB_DAILY_USD="2"

# Password reset delivery: verified sender in Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional administrator-only TikTok sandbox; never reuse production credentials.
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
# Optional shared X OAuth 2.0 Web App credentials. Workspace settings can override these.
X_CLIENT_ID=
X_CLIENT_SECRET=
